# Runs the logger health check once (triggered by train-health.timer every 5 min).
# Alert channel: HEALTH_NOTIFY_CMD in /etc/default/train-health (live server: ntfy push), e.g.
#   HEALTH_NOTIFY_CMD=curl -fsS -o /dev/null -H "Title: Train logger" -d @- https://ntfy.sh/<private-topic>
[Unit]
Description=Health check for the NS live logger

[Service]
Type=oneshot
User=train
WorkingDirectory=/opt/train-app
EnvironmentFile=-/etc/default/train-health
ExecStart=/opt/train-app/.venv/bin/python -m pipeline.health
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
